generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum ShoutoutType {
  TEAM_WIN
  PROJECT_MILESTONE
  WORK_ANNIVERSARY
  LIFE_MILESTONE
  ACTIVITY_HIGHLIGHT
  GENERAL_PRAISE
  OTHER
}

enum MentorshipCircleStatus {
  PROPOSED
  PENDING_APPROVAL
  FORMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MentorshipRole {
  MENTOR
  MENTEE
}

enum MembershipStatus {
  PENDING
  ACTIVE
  DECLINED
  REMOVED
  LEFT
}

enum AMASessionStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum UserRole {
  USER  // Regular user, default
  ADMIN // Platform administrator
}

// ++ Q&A Feature Enums ++
enum VoteType {
  UPVOTE
  // DOWNVOTE // Keep commented out unless downvoting is explicitly added
}
// ++ End Q&A Enums ++

// --- Auth Models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(USER)

  // Engagement Profile
  points       Int     @default(0)
  hobbies      String? @db.Text
  favoriteFood String?
  askMeAbout   String?

  // Relations to Auth
  accounts Account[]
  sessions Session[]

  // Relations to Engagement Features
  sentKudos                  Kudos[]            @relation("KudosGiver")
  receivedKudos              Kudos[]            @relation("KudosReceiver")
  PointLog                   PointLog[]
  submittedLearningResources LearningResource[] @relation("SubmittedByUser")
  submittedInnovationIdeas   InnovationIdea[]   @relation("SubmittedByUser")
  userBadges                 UserBadge[]
  shoutoutsSubmitted         Shoutout[]         @relation("SubmittedBy")
  shoutoutsRelatedTo         Shoutout[]         @relation("RelatedUser")
  createdCircles             MentorshipCircle[] @relation("CircleCreator")
  circleMemberships          MentorshipCircleMember[]
  hostedAMASessions          AMASession[]       @relation("HostedAMASessions")
  submittedAMAQuestions      AMAQuestion[]      @relation("SubmittedAMAQuestions")
  answeredAMAQuestions       AMAQuestion[]      @relation("AnsweredAMAQuestions")

  // ++ Q&A Feature Relations ++
  questions         Question[] @relation("QuestionAuthor")
  answers           Answer[]   @relation("AnswerAuthor")
  votes             Vote[]     @relation("Voter")
  // ++ End Q&A Relations ++
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Application Models ---

model Kudos {
  id         String     @id @default(cuid())
  message    String     @db.Text
  createdAt  DateTime   @default(now())
  giverId    String
  giver      User       @relation("KudosGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User       @relation("KudosReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  PointLog   PointLog[]

  @@index([createdAt])
  @@index([giverId])
  @@index([receiverId])
}

model PointLog {
  id            String   @id @default(cuid())
  pointsAwarded Int
  reason        String
  timestamp     DateTime @default(now())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Links to specific actions that generated points
  kudosId String?
  kudos   Kudos?  @relation(fields: [kudosId], references: [id], onDelete: SetNull)

  // ++ Q&A Feature Point Link ++
  acceptedAnswerId String? @unique // Ensure a PointLog entry is tied to only one accepted answer
  acceptedAnswer   Answer? @relation(fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  // ++ End Q&A Link ++

  // Consider adding links to other point sources later
  // badgeId String?
  // mentorshipCircleParticipationId String?

  @@index([userId])
  @@index([timestamp])
  @@index([kudosId])
  @@index([acceptedAnswerId])
}

model LearningResource {
  id            String   @id @default(cuid())
  title         String
  url           String   @db.Text
  description   String?  @db.Text
  submittedAt   DateTime @default(now())
  submittedById String
  submittedBy   User     @relation("SubmittedByUser", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([submittedAt])
  @@index([submittedById])
}

model InnovationIdea {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  submittedAt   DateTime @default(now())
  submittedById String
  submittedBy   User     @relation("SubmittedByUser", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([submittedAt])
  @@index([submittedById])
}

model Badge {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String      @db.Text
  iconName     String?
  criteriaDesc String?     @db.Text
  createdAt    DateTime    @default(now())
  userBadges   UserBadge[]

  @@index([name])
}

model UserBadge {
  id       String   @id @default(cuid())
  earnedAt DateTime @default(now())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Shoutout {
  id            String       @id @default(cuid())
  type          ShoutoutType
  message       String       @db.Text
  imageUrl      String?      @db.Text
  createdAt     DateTime     @default(now())
  relatedUserId String?
  relatedUser   User?        @relation("RelatedUser", fields: [relatedUserId], references: [id], onDelete: SetNull)
  submittedById String
  submittedBy   User         @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type])
  @@index([relatedUserId])
  @@index([submittedById])
}

model MentorshipSkill {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  circles     MentorshipCircle[]

  @@index([name])
}

model MentorshipCircle {
  id          String                 @id @default(cuid())
  title       String
  description String?                @db.Text
  status      MentorshipCircleStatus @default(FORMING)
  maxMentees  Int?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  skillId     String
  skill       MentorshipSkill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User                   @relation("CircleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     MentorshipCircleMember[]

  @@index([status])
  @@index([skillId])
  @@index([creatorId])
}

model MentorshipCircleMember {
  id       String           @id @default(cuid())
  role     MentorshipRole
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  circleId String
  circle   MentorshipCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
  @@index([circleId])
  @@index([status])
}

model AMASession {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  scheduledAt   DateTime
  status        AMASessionStatus @default(UPCOMING)
  isTechSpecific Boolean  @default(false)
  topic         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  hostId        String
  host          User      @relation("HostedAMASessions", fields: [hostId], references: [id], onDelete: Restrict) // Prevent deleting user if they hosted sessions
  questions     AMAQuestion[]

  @@index([status])
  @@index([scheduledAt])
  @@index([hostId])
}

model AMAQuestion {
  id            String    @id @default(cuid())
  text          String    @db.Text
  isAnonymous   Boolean   @default(false)
  answerText    String?   @db.Text
  answeredAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessionId     String
  session       AMASession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submittedById String?
  submittedBy   User?      @relation("SubmittedAMAQuestions", fields: [submittedById], references: [id], onDelete: SetNull) // Keep question if submitter deleted
  answeredById  String?
  answeredBy    User?      @relation("AnsweredAMAQuestions", fields: [answeredById], references: [id], onDelete: SetNull) // Keep answer if answerer deleted

  @@index([sessionId])
  @@index([submittedById])
  @@index([answeredAt])
}

// +++++++++++++++++++++++++++++++++++++++
// +++      Q&A Feature Models         +++
// +++++++++++++++++++++++++++++++++++++++

model Question {
  id        String   @id @default(cuid())
  title     String
  content   Json // Changed from String @db.Text to Json for Plate.js output
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade) // Delete question if author is deleted

  answers          Answer[]
  tags             QuestionTag[]
  votes            Vote[]           @relation("QuestionVotes")

  acceptedAnswerId String?          @unique // A question has zero or one accepted answer
  acceptedAnswer   Answer?          @relation("AcceptedAnswerForQuestion", fields: [acceptedAnswerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Need onDelete: NoAction here to prevent cycles if the accepted answer tries to delete the question

  @@index([authorId])
  @@index([createdAt])
  // Maybe add index for full-text search on title/content later depending on DB
}

model Answer {
  id         String   @id @default(cuid())
  content    Json // Changed from String @db.Text to Json for Plate.js output
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  authorId String
  author   User   @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade) // Delete answer if author is deleted

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade) // Delete answer if question is deleted

  votes      Vote[]   @relation("AnswerVotes")

  isAccepted     Boolean    @default(false) // Denormalized flag for easier querying
  acceptedIn     Question?  @relation("AcceptedAnswerForQuestion") // Link back to the question where this answer is accepted
  pointLogReward PointLog[] // Link to points awarded if this answer is accepted

  @@index([authorId])
  @@index([questionId])
  @@index([createdAt])
  @@index([isAccepted]) // Index potentially useful for finding accepted answers
}
model Tag {
  id        String        @id @default(cuid())
  name      String        @unique // Tag names should be unique
  createdAt DateTime      @default(now())
  questions QuestionTag[] // How many questions use this tag

  // Optional: Add description, createdBy etc. if needed
  // description String?

  @@index([name])
}

// Join table for Many-to-Many relationship between Question and Tag
model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade) // Remove link if question deleted
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)      // Remove link if tag deleted

  assignedAt DateTime @default(now())
  // assignedById String? // Optional: track who added the tag
  // assignedBy User? @relation("TagAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([questionId, tagId]) // Composite primary key ensures unique question-tag pair
  @@index([tagId]) // Index for finding questions by tag
}

model Vote {
  id        String   @id @default(cuid())
  voteType  VoteType
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("Voter", fields: [userId], references: [id], onDelete: Cascade) // Delete vote if user deleted

  // A vote belongs to EITHER a Question OR an Answer
  questionId String?
  question   Question? @relation("QuestionVotes", fields: [questionId], references: [id], onDelete: Cascade) // Delete vote if question deleted

  answerId String?
  answer   Answer?   @relation("AnswerVotes", fields: [answerId], references: [id], onDelete: Cascade) // Delete vote if answer deleted

  // Ensure a user can vote only once per question OR per answer
  @@unique([userId, questionId])
  @@unique([userId, answerId])

  // Add constraints later if needed to ensure questionId OR answerId is set, but not both

  @@index([userId])
  @@index([questionId])
  @@index([answerId])
}