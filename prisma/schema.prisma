// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // Ensure this output path is correct relative to your prisma folder
  // If prisma folder is at root, '../node_modules/.prisma/client' is likely correct
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum ShoutoutType {
  TEAM_WIN
  PROJECT_MILESTONE
  WORK_ANNIVERSARY
  LIFE_MILESTONE
  ACTIVITY_HIGHLIGHT
  GENERAL_PRAISE
  OTHER
}

// ++ Enums for Mentorship ++
enum MentorshipCircleStatus {
  PROPOSED // Mentor proposed, maybe pending admin review
  PENDING_APPROVAL // Explicit admin review step (optional workflow)
  FORMING // Approved/Created, open for mentees to join
  ACTIVE // Mentorship is happening
  COMPLETED // Mentorship concluded
  CANCELLED // Cancelled before/during activity
}

enum MentorshipRole {
  MENTOR
  MENTEE
}

enum MembershipStatus {
  PENDING // Requested to join (for MENTEE)
  ACTIVE // Approved member
  DECLINED // Request to join was declined
  REMOVED // Was removed by mentor/admin
  LEFT // Left voluntarily
}

// ++ End Enums for Mentorship ++

// --- Auth Models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // Assuming you might add credentials provider later
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Engagement Features
  points       Int     @default(0)
  hobbies      String? @db.Text
  favoriteFood String?
  askMeAbout   String?

  accounts                   Account[]
  sessions                   Session[]
  sentKudos                  Kudos[]            @relation("KudosGiver")
  receivedKudos              Kudos[]            @relation("KudosReceiver")
  PointLog                   PointLog[]
  submittedLearningResources LearningResource[] @relation("SubmittedByUser")
  submittedInnovationIdeas   InnovationIdea[]   @relation("SubmittedByUser")
  userBadges                 UserBadge[]
  shoutoutsSubmitted         Shoutout[]         @relation("SubmittedBy")
  shoutoutsRelatedTo         Shoutout[]         @relation("RelatedUser")

  // ++ Mentorship Relations ++
  createdCircles    MentorshipCircle[]       @relation("CircleCreator") // Circles this user initially proposed
  circleMemberships MentorshipCircleMember[] // Which circles they are a member of (as mentor or mentee)
  // ++ End Mentorship Relations ++
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Application Models ---

model Kudos {
  id         String     @id @default(cuid())
  message    String     @db.Text
  createdAt  DateTime   @default(now())
  giverId    String
  giver      User       @relation("KudosGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User       @relation("KudosReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  PointLog   PointLog[]

  @@index([createdAt])
}

model PointLog {
  id            String   @id @default(cuid())
  pointsAwarded Int
  reason        String
  timestamp     DateTime @default(now())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kudosId       String?
  kudos         Kudos?   @relation(fields: [kudosId], references: [id], onDelete: SetNull)
  // Consider adding links to other point sources later (e.g., badge earned, circle participation)
  // mentorshipCircleId String?
  // mentorshipCircle MentorshipCircle? @relation(fields: [mentorshipCircleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([timestamp])
}

model LearningResource {
  id            String   @id @default(cuid())
  title         String
  url           String   @db.Text
  description   String?  @db.Text
  submittedAt   DateTime @default(now())
  submittedById String
  submittedBy   User     @relation("SubmittedByUser", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([submittedAt])
}

model InnovationIdea {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  submittedAt   DateTime @default(now())
  submittedById String
  submittedBy   User     @relation("SubmittedByUser", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([submittedAt])
}

model Badge {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String      @db.Text
  iconName     String?
  criteriaDesc String?     @db.Text
  createdAt    DateTime    @default(now())
  userBadges   UserBadge[]

  @@index([name])
}

model UserBadge {
  id       String   @id @default(cuid())
  earnedAt DateTime @default(now())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Shoutout {
  id            String       @id @default(cuid())
  type          ShoutoutType
  message       String       @db.Text
  imageUrl      String?      @db.Text
  createdAt     DateTime     @default(now())
  relatedUserId String?
  relatedUser   User?        @relation("RelatedUser", fields: [relatedUserId], references: [id], onDelete: SetNull)
  submittedById String
  submittedBy   User         @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type])
  @@index([relatedUserId])
}

// +++++++++++++++++++++++++++++++++++++++
// +++ Reverse Mentorship Circles Models +++
// +++++++++++++++++++++++++++++++++++++++

model MentorshipSkill {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Advanced Slack Usage", "AI Prompt Engineering Basics"
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to Circles using this skill as the main topic
  circles MentorshipCircle[]

  @@index([name]) // Index for faster lookups by skill name
}

model MentorshipCircle {
  id          String                 @id @default(cuid())
  title       String // e.g., "Mastering Slack Shortcuts"
  description String?                @db.Text
  status      MentorshipCircleStatus @default(FORMING) // Defaults to FORMING when created via standard user flow
  maxMentees  Int? // Optional limit on number of mentees
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  // The main topic/skill for this circle
  skillId String
  skill   MentorshipSkill @relation(fields: [skillId], references: [id], onDelete: Cascade) // Cascade delete if skill is deleted

  // Who initially created/proposed this circle?
  creatorId String
  creator   User   @relation("CircleCreator", fields: [creatorId], references: [id], onDelete: Cascade) // Cascade delete if creator is deleted

  // Members of this circle (mentors and mentees)
  members MentorshipCircleMember[]

  // Optional: Consider adding fields for schedule notes, meeting links etc. later
  // scheduleNotes String?

  @@index([status])
  @@index([skillId])
  @@index([creatorId])
}

model MentorshipCircleMember {
  id       String           @id @default(cuid())
  role     MentorshipRole // MENTOR or MENTEE
  status   MembershipStatus @default(ACTIVE) // Mentors are active on creation, Mentees might be PENDING initially
  joinedAt DateTime         @default(now())

  // Relations
  circleId String
  circle   MentorshipCircle @relation(fields: [circleId], references: [id], onDelete: Cascade) // Cascade delete membership if circle is deleted

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade delete membership if user is deleted

  // Ensure a user can only be in a specific circle once
  @@unique([circleId, userId])
  // Indexing for performance
  @@index([userId])
  @@index([circleId])
  @@index([status]) // Index status for filtering members (e.g. find pending)
}

