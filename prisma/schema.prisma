// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enum for Shoutout Types ---
enum ShoutoutType {
  TEAM_WIN
  PROJECT_MILESTONE
  WORK_ANNIVERSARY // Consider privacy/consent for auto-posting these
  LIFE_MILESTONE // e.g., New baby, marriage (requires user submission)
  ACTIVITY_HIGHLIGHT // e.g., Successful event, volunteer work
  GENERAL_PRAISE
  OTHER
}

// --- Auth Models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // --- Add points field ---
  points Int @default(0) // Default points to 0
  // --- End Add ---

  accounts      Account[]
  sessions      Session[]
  sentKudos     Kudos[]    @relation("KudosGiver")
  receivedKudos Kudos[]    @relation("KudosReceiver")
  PointLog      PointLog[]

  // --- Add relations for Learning & Innovation ---
  submittedLearningResources LearningResource[] @relation("SubmittedByUser")
  submittedInnovationIdeas   InnovationIdea[]   @relation("SubmittedByUser")
  // --- End Add ---
  userBadges                 UserBadge[]
  shoutoutsSubmitted         Shoutout[]         @relation("SubmittedBy") // Shoutouts this user submitted
  shoutoutsRelatedTo         Shoutout[]         @relation("RelatedUser") // Shoutouts where this user is mentioned/tagged
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Application Models ---

model Kudos {
  id        String   @id @default(cuid())
  message   String   @db.Text // Use Text for potentially longer messages
  createdAt DateTime @default(now())

  // Relation to the User who gave the Kudos
  giverId String
  giver   User   @relation("KudosGiver", fields: [giverId], references: [id], onDelete: Cascade)

  // Relation to the User who received the Kudos
  receiverId String
  receiver   User       @relation("KudosReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  PointLog   PointLog[]

  @@index([createdAt]) // Index for sorting feed by time
}

// Optional but recommended: Add PointLog model for auditing later
model PointLog {
  id            String   @id @default(cuid())
  pointsAwarded Int
  reason        String // e.g., "Gave Kudos", "Received Kudos", "Admin Adjustment"
  timestamp     DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User

  // Optional: Link back to the specific Kudos that generated the points
  kudosId String?
  kudos   Kudos?  @relation(fields: [kudosId], references: [id], onDelete: SetNull) // SetNull if Kudos is deleted, but point log remains

  @@index([userId]) // Index for querying user's point history
  @@index([timestamp]) // Index for sorting logs by time
}

// --- Learning Module ---
model LearningResource {
  id          String   @id @default(cuid())
  title       String
  url         String   @db.Text // URL to the resource
  description String?  @db.Text // Optional description
  submittedAt DateTime @default(now())
  // approved    Boolean   @default(false) // Optional: Add later for admin approval workflow

  // Relation to the user who submitted it
  submittedById String
  submittedBy   User   @relation("SubmittedByUser", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([submittedAt])
}

// --- Innovation Module ---
model InnovationIdea {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text // Detailed description of the idea
  submittedAt DateTime @default(now())
  // status      String    @default("Submitted") // Optional: Track status (Submitted, Reviewing, Approved, Implemented)

  // Relation to the user who submitted it
  submittedById String
  submittedBy   User   @relation("SubmittedByUser", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([submittedAt])
}

// --- Badge System Models ---

// Represents the definition of an available badge
model Badge {
  id           String   @id @default(cuid())
  name         String   @unique // e.g., "Kudos Giver", "Welcome Aboard"
  description  String   @db.Text
  iconName     String? // Optional: Name of a lucide-react icon or identifier for custom image
  criteriaDesc String?  @db.Text // Optional: User-friendly description of how to earn it
  createdAt    DateTime @default(now())

  // Relation to users who have earned this badge
  userBadges UserBadge[]

  @@index([name])
}

// Join table connecting Users and the Badges they've earned
model UserBadge {
  id       String   @id @default(cuid())
  earnedAt DateTime @default(now())

  // Relation to User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relation to Badge definition
  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId]) // Ensure a user earns each badge only once
  @@index([userId])
  @@index([badgeId])
}

// --- Shoutout Model ---
model Shoutout {
  id        String       @id @default(cuid())
  type      ShoutoutType // Use the enum
  message   String       @db.Text
  imageUrl  String?      @db.Text // Optional URL for an image
  createdAt DateTime     @default(now())

  // Optional: For specific types like milestones or team wins
  relatedUserId String? // e.g., User celebrating anniversary
  relatedUser   User?   @relation("RelatedUser", fields: [relatedUserId], references: [id], onDelete: SetNull) // Use a different relation name
  // relatedTeamId String? // Link to a Team model if you add one later

  // Relation to the User who submitted the shoutout
  submittedById String
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type])
  @@index([relatedUserId])
}
