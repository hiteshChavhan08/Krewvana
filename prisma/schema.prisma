// schema.prisma

generator client {
  provider = "prisma-client-js"
  // output   = "../node_modules/.prisma/client" // Default output location
}

datasource db {
  provider = "postgresql" // Or your chosen database provider
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum ShoutoutType {
  TEAM_WIN
  PROJECT_MILESTONE
  WORK_ANNIVERSARY
  LIFE_MILESTONE
  ACTIVITY_HIGHLIGHT
  GENERAL_PRAISE
  OTHER
}

enum MentorshipCircleStatus {
  PROPOSED
  PENDING_APPROVAL
  FORMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MentorshipRole {
  MENTOR
  MENTEE
}

enum MembershipStatus {
  PENDING
  ACTIVE
  DECLINED
  REMOVED
  LEFT
}

enum AMASessionStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum UserRole {
  USER // Regular user, default
  ADMIN // Platform administrator
}

enum VoteType {
  UPVOTE
  // DOWNVOTE // Keep commented out unless downvoting is explicitly added
}

// ++ SUGGESTED: Enum for Point Log reasons ++
enum PointLogType {
  KUDOS_GIVEN
  KUDOS_RECEIVED
  ANSWER_ACCEPTED_AUTHOR // Points for the answer author
  ANSWER_ACCEPTED_SELECTOR // Points for the question author who accepted (if any)
  QUESTION_UPVOTE // If voting gives points
  ANSWER_UPVOTE // If voting gives points
  PROFILE_COMPLETION
  MENTORSHIP_COMPLETED_MENTOR
  MENTORSHIP_COMPLETED_MENTEE
  BADGE_EARNED
  IDEA_SUBMITTED
  RESOURCE_SUBMITTED
  OTHER // Generic catch-all
}

// ++ SUGGESTED: Enum for Notification types ++
enum NotificationType {
  KUDOS_RECEIVED
  ANSWER_ON_QUESTION
  QUESTION_ACCEPTED_ANSWER // Notify question author when answer accepted
  MENTORSHIP_REQUEST_RECEIVED
  MENTORSHIP_REQUEST_ACCEPTED
  MENTORSHIP_MEMBER_JOINED
  MENTORSHIP_CIRCLE_STARTING // Reminder maybe?
  BADGE_EARNED
  AMA_QUESTION_ANSWERED
  NEW_COMMENT // If comments are added later
  OTHER
}

// --- Auth Models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId]) // Add index
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // Add index
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(USER) // Platform Admin/User role

  // Engagement Profile
  points       Int     @default(0)
  hobbies      String? @db.Text
  favoriteFood String?
  askMeAbout   String?

  // ++ NEW: Job Position ++
  positionId String? // Foreign key for the user's primary position
  isPositionVerified Boolean   @default(false)
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull) // Allow user to exist without a position

  // Relations to Auth
  accounts Account[]
  sessions Session[]

  // Relations to Engagement Features
  sentKudos                  Kudos[]                  @relation("KudosGiver")
  receivedKudos              Kudos[]                  @relation("KudosReceiver")
  pointLogs                  PointLog[] // Renamed for clarity
  submittedLearningResources LearningResource[]       @relation("SubmittedByUser")
  submittedInnovationIdeas   InnovationIdea[]         @relation("SubmittedByUser")
  userBadges                 UserBadge[]
  shoutoutsSubmitted         Shoutout[]               @relation("SubmittedBy")
  shoutoutsRelatedTo         Shoutout[]               @relation("RelatedUser")
  createdCircles             MentorshipCircle[]       @relation("CircleCreator")
  circleMemberships          MentorshipCircleMember[]
  hostedAMASessions          AMASession[]             @relation("HostedAMASessions")
  submittedAMAQuestions      AMAQuestion[]            @relation("SubmittedAMAQuestions")
  answeredAMAQuestions       AMAQuestion[]            @relation("AnsweredAMAQuestions")

  // ++ NEW: Skills Relation ++
  userSkills UserSkill[] // Many-to-many link to skills

  // ++ Q&A Feature Relations ++
  questions Question[] @relation("QuestionAuthor")
  answers   Answer[]   @relation("AnswerAuthor")
  votes     Vote[]     @relation("Voter")

  // ++ SUGGESTED: Notifications Relation ++
  notifications Notification[] @relation("RecipientUser")

  @@index([positionId]) // Index the new foreign key
  @@index([points]) // Index points for leaderboard
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Application Models ---

// ++ NEW: User's Job Position ++
model Position {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Software Engineer", "HR Manager", "CEO", "QA Tester"
  description String?  @db.Text
  createdAt   DateTime @default(now())
  users       User[] // Users holding this position

  @@index([name])
}

// ++ NEW: Skills ++
model Skill {
  id          String      @id @default(cuid())
  name        String      @unique // e.g., "React", "Python", "Project Management"
  description String?     @db.Text
  category    String? // ++ Optional Category (e.g., "Frontend", "Backend", "Soft Skill") ++
  createdAt   DateTime    @default(now())
  userSkills  UserSkill[] // Link to users possessing this skill

  @@index([name])
  @@index([category]) // Index category if added
}

// ++ NEW: User-Skill Join Table (Many-to-Many) ++
model UserSkill {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  assignedAt  DateTime @default(now())
  // ++ Optional Proficiency/Interest ++
  proficiency Int? // e.g., 1-5 scale, null if not specified
  // isInterested Boolean @default(false) // Or maybe skill goal?

  @@id([userId, skillId]) // Composite primary key
  @@index([skillId])
  @@index([userId])
}

model Kudos {
  id            String         @id @default(cuid())
  message       String         @db.Text
  createdAt     DateTime       @default(now())
  giverId       String
  giver         User           @relation("KudosGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User           @relation("KudosReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  pointLogs     PointLog[] // Renamed for clarity
  notifications Notification[] // ++ SUGGESTED: Notifications Link ++

  @@index([createdAt])
  @@index([giverId])
  @@index([receiverId])
}

model PointLog {
  id            String        @id @default(cuid())
  pointsAwarded Int
  type          PointLogType? // ++ SUGGESTED: Use Type Enum ++
  reason        String? // ++ SUGGESTED: Optional reason text ++
  timestamp     DateTime      @default(now())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Links to specific actions that generated points
  kudosId          String?
  kudos            Kudos?  @relation(fields: [kudosId], references: [id], onDelete: SetNull)
  acceptedAnswerId String? @unique // Ensure a PointLog entry is tied to only one accepted answer
  acceptedAnswer   Answer? @relation(fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  badgeId          String? // ++ SUGGESTED: Link to earned badge ++
  badge            Badge?  @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  // Add links to other sources: ideaId, resourceId, etc.

  @@index([userId])
  @@index([timestamp])
  @@index([kudosId])
  @@index([acceptedAnswerId])
  @@index([badgeId])
  @@index([type])
}

model LearningResource {
  id            String   @id @default(cuid())
  title         String
  url           String   @db.Text
  description   String?  @db.Text
  submittedAt   DateTime @default(now())
  submittedById String
  submittedBy   User     @relation("SubmittedByUser", fields: [submittedById], references: [id], onDelete: Cascade)
  // Add points relation if submitting grants points
  // pointLog PointLog?

  @@index([submittedAt])
  @@index([submittedById])
}

model InnovationIdea {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  submittedAt   DateTime @default(now())
  submittedById String
  submittedBy   User     @relation("SubmittedByUser", fields: [submittedById], references: [id], onDelete: Cascade)
  // Add points relation if submitting grants points
  // pointLog PointLog?

  @@index([submittedAt])
  @@index([submittedById])
}

model Badge {
  id           String         @id @default(cuid())
  name         String         @unique
  description  String         @db.Text
  iconName     String? // e.g., "Star", "Heart", used by frontend to map to an icon component
  criteriaDesc String?        @db.Text // Textual description of how to earn
  createdAt    DateTime       @default(now())
  userBadges   UserBadge[]
  pointLogs    PointLog[] // ++ SUGGESTED: Link for points awarded when badge earned ++
  Notification Notification[]

  @@index([name])
}

model UserBadge {
  id       String   @id @default(cuid())
  earnedAt DateTime @default(now())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Shoutout {
  id            String       @id @default(cuid())
  type          ShoutoutType
  message       String       @db.Text
  imageUrl      String?      @db.Text
  createdAt     DateTime     @default(now())
  relatedUserId String? // User mentioned in the shoutout (optional)
  relatedUser   User?        @relation("RelatedUser", fields: [relatedUserId], references: [id], onDelete: SetNull)
  submittedById String
  submittedBy   User         @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type])
  @@index([relatedUserId])
  @@index([submittedById])
}

model MentorshipSkill {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  circles     MentorshipCircle[] // Circles focused on this skill

  @@index([name])
}

model MentorshipCircle {
  id          String                   @id @default(cuid())
  title       String
  description String?                  @db.Text
  status      MentorshipCircleStatus   @default(FORMING)
  maxMentees  Int?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  skillId     String // Skill the circle focuses on
  skill       MentorshipSkill          @relation(fields: [skillId], references: [id], onDelete: Restrict) // Don't delete skill if circles exist
  creatorId   String // User who proposed/created the circle
  creator     User                     @relation("CircleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     MentorshipCircleMember[]

  @@index([status])
  @@index([skillId])
  @@index([creatorId])
}

model MentorshipCircleMember {
  id       String           @id @default(cuid())
  role     MentorshipRole // Mentor or Mentee
  status   MembershipStatus @default(ACTIVE) // Status within the circle
  joinedAt DateTime         @default(now())
  circleId String
  circle   MentorshipCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId]) // User can only be in a circle once
  @@index([userId])
  @@index([circleId])
  @@index([status])
}

model AMASession {
  id             String           @id @default(cuid())
  title          String
  description    String?          @db.Text
  scheduledAt    DateTime
  status         AMASessionStatus @default(UPCOMING)
  isTechSpecific Boolean          @default(false)
  topic          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  hostId         String
  host           User             @relation("HostedAMASessions", fields: [hostId], references: [id], onDelete: Restrict) // Keep host user even if they leave?
  questions      AMAQuestion[]

  @@index([status])
  @@index([scheduledAt])
  @@index([hostId])
}

model AMAQuestion {
  id            String         @id @default(cuid())
  text          String         @db.Text
  isAnonymous   Boolean        @default(false)
  isApproved    Boolean        @default(false) // ++ ADDED: Approval status ++
  answerText    String?        @db.Text
  answeredAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessionId     String
  session       AMASession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submittedById String? // Nullable if anonymous or user deleted
  submittedBy   User?          @relation("SubmittedAMAQuestions", fields: [submittedById], references: [id], onDelete: SetNull)
  answeredById  String? // Nullable if not answered or answerer deleted
  answeredBy    User?          @relation("AnsweredAMAQuestions", fields: [answeredById], references: [id], onDelete: SetNull)
  notifications Notification[] // ++ SUGGESTED: Notifications Link ++

  @@index([sessionId])
  @@index([submittedById])
  @@index([answeredAt])
  @@index([isApproved]) // Index approval status
}

// +++++++++++++++++++++++++++++++++++++++
// +++      Q&A Feature Models         +++
// +++++++++++++++++++++++++++++++++++++++

model Question {
  id        String   @id @default(cuid())
  title     String
  content   Json // For Plate.js or similar rich text editor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  answers Answer[]
  tags    QuestionTag[]
  votes   Vote[]        @relation("QuestionVotes")

  acceptedAnswerId String?        @unique // One accepted answer per question
  acceptedAnswer   Answer?        @relation("AcceptedAnswerForQuestion", fields: [acceptedAnswerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Add @@fulltext index if needed for searching title/content
  Notification     Notification[]

  @@index([authorId])
  @@index([createdAt])
}

model Answer {
  id        String   @id @default(cuid())
  content   Json // For Plate.js or similar rich text editor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  votes Vote[] @relation("AnswerVotes")

  isAccepted     Boolean        @default(false) // Denormalized flag
  acceptedIn     Question?      @relation("AcceptedAnswerForQuestion") // Link back to the question
  pointLogReward PointLog[] // Link to points awarded
  notifications  Notification[] // ++ SUGGESTED: Notifications Link ++

  @@index([authorId])
  @@index([questionId])
  @@index([createdAt])
  @@index([isAccepted])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique // Tag names (lowercase recommended)
  createdAt DateTime      @default(now())
  questions QuestionTag[]

  // Optional: Add description
  // description String?

  @@index([name])
}

// Q&A Join table for Question <-> Tag
model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([questionId, tagId])
  @@index([tagId])
}

model Vote {
  id        String   @id @default(cuid())
  voteType  VoteType // Currently just UPVOTE
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("Voter", fields: [userId], references: [id], onDelete: Cascade)

  // Vote is for EITHER Question OR Answer
  questionId String?
  question   Question? @relation("QuestionVotes", fields: [questionId], references: [id], onDelete: Cascade)

  answerId String?
  answer   Answer? @relation("AnswerVotes", fields: [answerId], references: [id], onDelete: Cascade)

  // Check constraint (can be handled in application logic too)
  // Ensure either questionId or answerId is non-null, but not both.

  // Ensure unique vote per user per item
  @@unique([userId, questionId])
  @@unique([userId, answerId])
  @@index([userId])
  @@index([questionId])
  @@index([answerId])
}

// ++ SUGGESTED: Notification Model ++
model Notification {
  id        String           @id @default(cuid())
  userId    String // The user receiving the notification
  user      User             @relation("RecipientUser", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType // Use the specific enum
  message   String           @db.Text // The notification text
  isRead    Boolean          @default(false) // Read status
  url       String? // Optional URL to link to (e.g., /app/kudos, /app/qna/questions/...)
  createdAt DateTime         @default(now())

  // Optional: Link to the source entity that triggered the notification
  kudosId       String?
  kudos         Kudos?       @relation(fields: [kudosId], references: [id], onDelete: Cascade) // If kudos deleted, notification deleted too? Or SetNull?
  answerId      String?
  answer        Answer?      @relation(fields: [answerId], references: [id], onDelete: Cascade) // Delete notification if answer deleted?
  questionId    String? // Could link to question for new answer notification etc.
  question      Question?    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  amaQuestionId String? // Link to an answered AMA question
  amaQuestion   AMAQuestion? @relation(fields: [amaQuestionId], references: [id], onDelete: Cascade)
  badgeId       String?
  badge         Badge?       @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)]) // Common query pattern
}
