// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Define the database connection (PostgreSQL in this case)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Make sure DATABASE_URL is set in your .env file
}

// Define the Prisma Client generator
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

// --- User and Authentication Models ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String? // Profile picture URL
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  passwordHash  String? // Store hashed password here if using Credentials provider

  // Role for basic permissions (optional, can be expanded)
  role Role @default(USER)

  // Relations
  accounts                   Account[] // For next-auth: OAuth accounts
  sessions                   Session[] // For next-auth: User sessions
  profile                    Profile? // Link to detailed user profile
  givenRecognitions          Recognition[]          @relation("Giver")
  receivedRecognitions       Recognition[]          @relation("Recipient")
  enrollments                Enrollment[]
  ideas                      Idea[]
  votes                      Vote[]
  comments                   Comment[]
  challengeSubmissions       ChallengeSubmission[]
  moodLogs                   MoodLog[] // User's mood logs (private)
  wellnessActivities         WellnessActivity[] // Manually logged activities
  authoredPosts              Post[]
  groupMemberships           GroupMember[]
  notifications              Notification[]         @relation("RecipientUser")
  redemptions                Redemption[]
  sentNotifications          Notification[]         @relation("SenderUser") // If sender is a user
  mentorshipSessionsAsMentor MentorshipSession[]    @relation("Mentor")
  mentorshipSessionsAsMentee MentorshipSession[]    @relation("Mentee")
  skillsOwned                Skill[]                @relation("Owner")
  skillsInterested           SkillInterest[]
  workshopRegistrations      WorkshopRegistration[] // Added opposite relation
  challengeParticipations    ChallengeParticipant[] // Added opposite relation
  earnedUserBadges           UserBadge[] // Added opposite relation
}

model Profile {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio        String?
  department String?
  jobTitle   String?
  location   String?
  interests  String[] // Array of strings for interests/hobbies
  skills     String[] // Array of strings for professional skills
  points     Int       @default(0) // Gamification points
  lastLogin  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // NOTE: Removed earnedBadges relation from here, moved to User model as earnedUserBadges
}

// --- NextAuth specific models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Learning Hub Models ---
model Course {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  source      String? // e.g., "Internal", "LinkedIn Learning", "Coursera"
  url         String? // URL to external course if applicable
  imageUrl    String?
  difficulty  String? // e.g., "Beginner", "Intermediate", "Advanced"
  tags        String[] // e.g., ["Management", "Tech", "Design"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  enrollments       Enrollment[]
  learningPathItems LearningPathItem[]
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  status      String    @default("Not Started") // e.g., "Not Started", "In Progress", "Completed"
  progress    Int       @default(0) // Percentage completion
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId]) // User can only enroll once per course
}

model Workshop {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  startTime    DateTime
  endTime      DateTime
  location     String? // "Virtual" or physical location
  meetingUrl   String?
  recordingUrl String?
  presenter    String? // Internal or external presenter name
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  registrations WorkshopRegistration[]
}

model WorkshopRegistration {
  id           String   @id @default(cuid())
  userId       String
  workshopId   String
  registeredAt DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([userId, workshopId])
}

model LearningPath {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items LearningPathItem[]
}

model LearningPathItem {
  id             String @id @default(cuid())
  learningPathId String
  courseId       String
  order          Int // Order of the course in the path

  // Relations
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade) // Assuming only courses for now

  @@unique([learningPathId, courseId])
  @@index([learningPathId, order])
}

model MentorshipSession {
  id              String   @id @default(cuid())
  mentorId        String
  menteeId        String
  scheduledTime   DateTime
  durationMinutes Int?
  topic           String?
  notes           String?  @db.Text
  status          String   @default("Scheduled") // e.g., Scheduled, Completed, Cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  mentor User @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee User @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String  @id @default(cuid())
  name        String  @unique // e.g., "React", "Project Management"
  description String?
  ownerId     String? // Optional: If a specific user 'owns' or is the primary expert

  // Relations
  owner           User?           @relation("Owner", fields: [ownerId], references: [id], onDelete: SetNull)
  interestedUsers SkillInterest[]
}

model SkillInterest {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     String // e.g., "Interested", "Learning", "Proficient"
  createdAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

// --- Innovation Hub Models ---
model Idea {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  category    String? // e.g., "Product", "Process", "Culture"
  status      String   @default("Submitted") // e.g., Submitted, Under Review, Approved, Implemented, Rejected
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  author              User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes               Vote[]
  comments            Comment[]
  challengeSubmission ChallengeSubmission? // If idea is part of a challenge submission
}

model Vote {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  type      VoteType // UP or DOWN
  createdAt DateTime @default(now())

  // Relations
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId]) // User can only vote once per idea
}

model Comment {
  id        String   @id @default(cuid())
  text      String   @db.Text
  ideaId    String? // Comment on an Idea
  postId    String? // Comment on a Post
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  idea   Idea? @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  post   Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Add constraint if needed: Ensure either ideaId or postId is set, but not both
}

// --- Wellness Models ---
model WellnessChallenge {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  type        String // e.g., "Steps", "ActivityMinutes", "Mindfulness"
  goal        Float? // e.g., 10000 steps, 150 minutes
  startDate   DateTime
  endDate     DateTime
  isTeamBased Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id                  String   @id @default(cuid())
  userId              String
  wellnessChallengeId String
  joinedAt            DateTime @default(now())
  progress            Float? // Current progress towards the goal

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User
  wellnessChallenge WellnessChallenge @relation(fields: [wellnessChallengeId], references: [id], onDelete: Cascade)

  @@unique([userId, wellnessChallengeId])
}

model WellnessActivity {
  id        String   @id @default(cuid())
  userId    String
  type      String // e.g., "Running", "Yoga", "Cycling"
  duration  Int? // Duration in minutes
  distance  Float? // Distance in km/miles
  steps     Int?
  calories  Int?
  date      DateTime // Date the activity occurred
  source    String   @default("Manual") // "Manual", "Fitbit", "Google Fit"
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  moodLevel Int // e.g., 1 (low) to 5 (high)
  notes     String? // Optional notes
  date      DateTime @default(now()) // Logged date/time

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// --- Collaboration Models ---
model Group {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  type        GroupType @default(INTEREST) // INTEREST, PROJECT, TEAM
  isPublic    Boolean   @default(true) // Publicly visible/joinable vs invite-only
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  members GroupMember[]
  posts   Post[]
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER) // MEMBER, ADMIN
  joinedAt DateTime  @default(now())

  // Relations
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Post {
  id             String   @id @default(cuid())
  title          String?
  content        String   @db.Text
  authorId       String
  groupId        String? // Belongs to a group
  isAnnouncement Boolean  @default(false) // e.g., for Team Hubs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group    Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  comments Comment[]
}

model KnowledgeBaseArticle {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  slug      String   @unique // URL-friendly identifier
  category  String?
  tags      String[]
  authorId  String // Could be a system user or specific user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Add relation to author if needed (User model)
}

// --- Culture & Recognition Models ---
model Recognition {
  id          String   @id @default(cuid())
  giverId     String
  recipientId String
  message     String   @db.Text
  valueTag    String? // Company value associated, e.g., "Teamwork", "Innovation"
  points      Int? // Points awarded with recognition
  badgeId     String? // Optional badge awarded directly via this recognition
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations
  giver          User       @relation("Giver", fields: [giverId], references: [id], onDelete: Cascade)
  recipient      User       @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  // Explicit relation name for the optional badge link
  badgeAwarded   Badge?     @relation("DirectBadgeAward", fields: [badgeId], references: [id], onDelete: SetNull)
  // Link to the UserBadge entry created as a result of this recognition (if any)
  userBadgeGrant UserBadge? @relation("RecognitionGrantingBadge") // Corrected opposite relation
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String? // URL or path to badge image
  criteria    String? // How the badge is earned
  createdAt   DateTime @default(now())

  // Relations
  // Recognitions that directly awarded this badge (optional link)
  recognitionsAwarding Recognition[] @relation("DirectBadgeAward") // Corrected opposite relation
  // Users who have earned this badge (via the join table)
  usersWithBadge       UserBadge[] // Corrected opposite relation
}

// Join table for User and Badge (Many-to-Many)
model UserBadge {
  id            String       @id @default(cuid())
  userId        String
  badgeId       String
  earnedAt      DateTime     @default(now())
  // Optional: Link to the specific Recognition that granted the badge
  recognitionId String?      @unique // A UserBadge entry is created by max one Recognition
  recognition   Recognition? @relation("RecognitionGrantingBadge", fields: [recognitionId], references: [id], onDelete: SetNull) // Corrected relation

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade) // Relation to Badge

  // NOTE: Removed profile relation - access profile via user relation
  @@unique([userId, badgeId]) // User earns each badge type only once (or track multiple instances differently)
}

// NOTE: Removed the AwardedRecognition model - simplified structure

// --- Rewards & Gamification Models ---
model RewardItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  pointsCost  Int
  stock       Int? // Optional: Limited stock
  isActive    Boolean  @default(true) // Can be disabled without deleting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  redemptions Redemption[]
}

model Redemption {
  id          String    @id @default(cuid())
  userId      String
  itemId      String
  pointsSpent Int
  status      String    @default("Pending") // Pending, Fulfilled, Cancelled
  redeemedAt  DateTime  @default(now())
  fulfilledAt DateTime?

  // Relations
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item RewardItem @relation(fields: [itemId], references: [id], onDelete: Restrict) // Don't delete item if redeemed
}

// --- Innovation Challenge Models (distinct from Wellness) ---
model InnovationChallenge {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  theme           String? // e.g., "Sustainability", "Customer Experience"
  startDate       DateTime
  endDate         DateTime
  judgingCriteria String?  @db.Text
  prize           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  submissions ChallengeSubmission[]
}

model ChallengeSubmission {
  id             String   @id @default(cuid())
  challengeId    String
  submitterId    String // User who submitted
  teamName       String? // If submitted by a team
  ideaId         String?  @unique // Link to the submitted Idea (optional, could be direct text/files)
  submissionText String?  @db.Text // Direct submission details if not linking to Idea
  submittedAt    DateTime @default(now())
  score          Int? // Score from judging
  isWinner       Boolean  @default(false)

  // Relations
  challenge InnovationChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submitter User                @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  idea      Idea?               @relation(fields: [ideaId], references: [id], onDelete: SetNull)
}

// --- Notifications ---
model Notification {
  id          String           @id @default(cuid())
  recipientId String // User receiving the notification
  senderId    String? // User who triggered the notification (optional, could be system)
  type        NotificationType // e.g., RECOGNITION, NEW_COURSE, MENTION, etc.
  message     String
  link        String? // Link to relevant content (e.g., recognition, course)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  // Relations
  recipient User  @relation("RecipientUser", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User? @relation("SenderUser", fields: [senderId], references: [id], onDelete: SetNull) // Sender is optional
}

// --- ENUMS ---
enum Role {
  USER
  ADMIN
  MANAGER // Example additional role
}

enum VoteType {
  UP
  DOWN
}

enum GroupType {
  INTEREST
  PROJECT
  TEAM // Official department/team group
}

enum GroupRole {
  MEMBER
  ADMIN
}

enum NotificationType {
  RECOGNITION_RECEIVED
  NEW_COURSE_AVAILABLE
  WORKSHOP_REMINDER
  MENTION_IN_COMMENT
  MENTION_IN_POST
  IDEA_VOTED
  IDEA_COMMENTED
  CHALLENGE_STARTING
  CHALLENGE_ENDING
  NEW_ANNOUNCEMENT
  GROUP_INVITE
  REWARD_REDEEMED
  BADGE_EARNED
  // Add more as needed
}
